// Approach 1 

int minimumMultiplications(vector<int>& arr, int start, int end) {
        // code here
        priority_queue<pair<int, int>, vector<pair<int, int>>, 
        greater<pair<int, int>>> pq;
        pq.push({0, start});
        vector<int> number(1e5, INT_MAX);
        number[start]=0;
        
        while(!pq.empty())
        {
            auto it=pq.top();
            pq.pop();
            int steps=it.first;
            int num=it.second;
            if(num==end)
            {
                return steps;
            }
            
            for(int i=0; i<arr.size(); i++)
            {
                int newNum=(num*arr[i]) % 100000;
                if(steps + 1<number[newNum])
                {
                    number[newNum]=steps +1;
                    if(newNum==end)
                    {
                        return steps+1;
                    }
                    pq.push({steps+1, newNum});
                }
            }
        }
        return -1;
    }
