// Approach 1 -> topological sorting (reverse the graph edges then get the topo sort that will be the ans)

class Solution {
public:
    vector<int> eventualSafeNodes(vector<vector<int>>& graph) {
        int n=graph.size();
        vector<vector<int>> adj(n);
        for (int i = 0; i < n; i++) 
        {
            for (auto node : graph[i]) {
                adj[node].push_back(i);  // Reverse the graph to store incoming edges
            }
        }

        queue<int> q;
        vector<int> indegree(n, 0);

        for(int i=0; i<n; i++)
        {
            for(auto it: adj[i])
            {
                indegree[it]++;
            }
        }

        for(int i=0; i<n; i++)
        {
            if(indegree[i]==0)
            {
                q.push(i);
            }
        }

        vector<int> ans;
        while(!q.empty())
        {
            int node=q.front();
            q.pop();
            ans.push_back(node);

            for(auto it: adj[node])
            {
                indegree[it]--;
                if(indegree[it]==0)
                {
                    q.push(it);
                }
            }
        }
        sort(ans.begin(), ans.end());
        return ans;
    }
};
