// Approach 1 

class Solution {
public:
    int findCheapestPrice(int n, vector<vector<int>>& flights, int src, int dst, int k) {
        vector<vector<pair<int, int>>> adj(n);
        for(int i=0; i<flights.size(); i++)
        {
            int u = flights[i][0];
            int v= flights[i][1];
            int w=flights[i][2];

            adj[u].push_back({v, w});
        }

        queue<pair<int, pair<int, int>>> q;
        q.push({0, {src, k+1}});
        vector<int> costs(n, INT_MAX);
        costs[src]=0;
        
        while(!q.empty())
        {
            auto it = q.front();
            q.pop();
            int cost=it.first;
            int node=it.second.first;
            int stop=it.second.second;
            if(stop==0)
            {
                if(costs[dst]==INT_MAX)
                {
                    return -1;
                }
                return costs[dst];
            }
            for(auto neigh : adj[node])
            {
                if(neigh.second + cost <  costs[neigh.first])
                {
                    costs[neigh.first] = cost + neigh.second;
                    q.push({costs[neigh.first], {neigh.first, stop-1}});
                }
            }
        }
        if(costs[dst]==INT_MAX)
                {
                    return -1;
                }
                return costs[dst];
    }
};
